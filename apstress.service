[Unit]
Description=apstress - scope-locked, opt-in, time-bounded AP thermal/power stress load (own-AP characterization)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/wpacrack/apstress.py
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=30
# self-bounded by stress_max_seconds; headroom then hard-stop
TimeoutStartSec=2400

# intentionally NOT boot-enabled — it is a flood; runs only when armed + started (sudo apstress-run).

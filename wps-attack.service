[Unit]
Description=wps-attack - continual lockout-safe WPS recovery (pixie->online PIN), coexists with the WPA harvest
After=network.target

[Service]
Type=simple
# spare-resources only: lowest CPU niceness + idle IO class (harvest stays primary)
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
ExecStart=/usr/bin/python3 /opt/wpacrack/wps_attack.py --daemon
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

[Unit]
Description=wps-attack - scope-locked lockout-safe WPS pixie/online attempt (authorized targets, opt-in)
After=network.target

[Service]
Type=oneshot
# spare-resources only: lowest CPU niceness + idle IO class (coexists with the harvest)
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
ExecStart=/usr/bin/python3 /opt/wpacrack/wps_attack.py
# tool is self-bounded; give the whole pass generous headroom then hard-stop
TimeoutStartSec=2400

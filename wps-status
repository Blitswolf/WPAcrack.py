#!/bin/bash
echo "=== service ==="; systemctl is-enabled wps-attack.service 2>/dev/null; systemctl is-active wps-attack.service 2>/dev/null
systemctl --no-pager -n 3 status wps-attack.service 2>/dev/null | tail -3
echo; echo "=== armed? ==="; grep -qiE '^\s*wps_enabled\s*=\s*(true|yes|on|1)' /opt/wpacrack/wpacrack.conf 2>/dev/null && echo "ARMED (wps_enabled=true)" || echo "DORMANT (wps_enabled not true — no frames sent)"
echo; echo "=== WPS_STATUS.txt ==="; cat /opt/wpacrack/WPS_STATUS.txt 2>/dev/null || echo "(none yet)"
echo; echo "=== cooldown markers ==="; ls -1 /opt/wpacrack/wps_state/ 2>/dev/null || echo "(none)"
echo; echo "=== loot ==="; find /opt/wpacrack/loot -name '*.loot' 2>/dev/null | sed 's,^,  ,'; [ -s /root/wps_loot.txt ] && echo "  (see /root/wps_loot.txt)"
echo; echo "=== last 12 log lines ==="; tail -12 /opt/wpacrack/wps.log 2>/dev/null || echo "(no log)"

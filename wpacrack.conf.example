# wpacrack site config - copy to wpacrack.conf and fill in YOUR OWN authorized AP.
# The real wpacrack.conf is gitignored so your AP identifiers never reach the repo.
# wpacrack refuses to run without a valid 'targets' line (so it can never deauth a stray BSSID).

iface       = wlan1
essid       = YOUR_LAB_SSID
# BSSID:CHANNEL pairs, comma-separated (put the 2.4GHz BSS first = preferred).
# A dual-band AP usually has two BSSIDs differing only in the last hex digit - list both.
targets     = AA:BB:CC:DD:EE:FF:1, AA:BB:CC:DD:EE:F0:36
# OPTIONAL: seed words -> emitted as candidates.txt to copy to your GPU cracking box.
# Not used for cracking on the Pi (the Pi only captures). Leave blank to skip.
custom_seeds =

# --- harvest mode (wpacrack.py --harvest): continuous capture into a library ---
library      = /opt/wpacrack/library
cooldown     = 1800      # seconds to idle between capture cycles
refresh_ttl  = 86400     # skip a BSSID that already has a handshake newer than this (seconds)

# --- WPS attack module (wps_attack.py) ---
# HARD opt-in gate: nothing transmits until this is true (use `sudo wps-arm` / `sudo wps-disarm`).
wps_enabled            = false
wps_online_enabled     = true        # step-3 online PIN fallback (pixie is step 2, always first)
wps_reaver_delay       = 15          # -d : seconds between PIN attempts
wps_reaver_throttle    = 3:60        # -r : after 3 attempts, sleep 60s
wps_online_max_seconds = 900         # hard cap on the whole online attempt
wps_retry_cooldown     = 21600       # 6h : skip a target that yielded nothing
wps_lock_cooldown      = 86400       # 24h : long back-off after any lock/rate-limit signal
wps_cycle_idle         = 1800      # daemon: seconds to idle between full target sweeps

# --- evil-twin module (eviltwin.py) : opt-in, time-bounded PSK credential capture ---
# HARD opt-in gate: no AP broadcasts until true. Higher-consequence than WPS (it deceives a human),
# so it is start-on-demand only (never enabled at boot). Use `sudo eviltwin-arm` then `sudo eviltwin-run`.
eviltwin_enabled     = false
# dedicated AP radio. If its chipset can't sustain AP-mode TX (e.g. the mt76x0u/AWUS036ACHM), the
# module auto-detects that and falls back to borrowing the harvest radio (wlan1) time-sliced.
eviltwin_iface       = wlan2
# optional monitor radio for client herding (needs reliable TX; empty = passive/pre-herd only)
eviltwin_deauth_iface =
eviltwin_deauth      = false     # herd clients off the real AP (bounded, jittered / pre-herd burst)
eviltwin_ttl         = 1200      # hard cap on one session (seconds), then full teardown
eviltwin_portal_ip   = 10.0.0.1

# --- aprecon (RF-side research enrichment) ---
aprecon_sniff_secs   = 45      # passive monitor capture window per target (client inventory + PNL)
aprecon_wps_m1       = true    # read the AP's WPS M1 device attributes (lockout-safe: no PIN sent).
                               # Respects the WPS module's per-target cooldown (won't poke a rate-limited AP).

# --- apstress (AP thermal/power stress load — own-AP hardware characterization) ---
# HARD opt-in gate: no flooding until true. On-demand only (never boot-enabled). It is a DoS load;
# sends NO WPS frames so it cannot cause a WPS lockout. Use `sudo apstress-arm` then `sudo apstress-run`.
stress_enabled     = false
stress_iface       = wlan1     # needs reliable injection (the RTL8812AU), borrowed via the radio lock
stress_max_seconds = 900       # HARD cap per run (primary safety bound; stop early with apstress-stop)
stress_cooldown    = 180       # daemon: radio YIELD between floods (short = AP stays hot)
